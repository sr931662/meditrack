# Copy to .env and edit. Never commit real values.
MEDTRACK_ENV=development            # development | production
MEDTRACK_DATABASE_URL=postgresql+psycopg://medtrack:CHANGE_ME@localhost:5432/medtrack
# REQUIRED in production: random, >= 32 chars (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
MEDTRACK_JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
MEDTRACK_ACCESS_TOKEN_TTL_MINUTES=15
MEDTRACK_REFRESH_TOKEN_TTL_DAYS=30
# mock = in-process fake providers (dev/test only, refused in production). live = real adapters.
MEDTRACK_PROVIDER_MODE=mock
MEDTRACK_CORS_ORIGINS=[]

# --- WhatsApp Cloud API (live mode) ---
MEDTRACK_WHATSAPP_PHONE_NUMBER_ID=
MEDTRACK_WHATSAPP_ACCESS_TOKEN=
# --- Twilio voice / IVR (live mode) ---
MEDTRACK_IVR_ACCOUNT_SID=
MEDTRACK_IVR_AUTH_TOKEN=
MEDTRACK_IVR_FROM_NUMBER=
